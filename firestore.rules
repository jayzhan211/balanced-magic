rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 正式存檔（7NagGHeso22QC5bBCStwkiGO）與雲端測試空間（7NagGHeso22QC5bBCStwkiGOT）
    match /balance/{pair}/players/{player} {
      allow read: if request.auth != null && (pair == '7NagGHeso22QC5bBCStwkiGO' || pair == '7NagGHeso22QC5bBCStwkiGOT');
      allow write: if request.auth != null && (pair == '7NagGHeso22QC5bBCStwkiGO' || pair == '7NagGHeso22QC5bBCStwkiGOT')
                   && player in ['j', 'her']
                   && request.resource.data.keys().size() < 40;
    }
  }
}
