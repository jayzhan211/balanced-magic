rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /balance/{pair}/players/{player} {
      allow read: if request.auth != null && pair == '7NagGHeso22QC5bBCStwkiGO';
      allow write: if request.auth != null && pair == '7NagGHeso22QC5bBCStwkiGO'
                   && player in ['j', 'her']
                   && request.resource.data.keys().size() < 30;
    }
  }
}
